# Copie para .env se for chamar a API. O arquivo .env não entra no git.
# A suíte de testes não lê estas variáveis: ela usa clientes falsos.

# Chave da TypeSafe. TYPESAFE_API_KEY ganha de JEV_API_KEY quando as duas existem.
TYPESAFE_API_KEY=
JEV_API_KEY=

# Origem, sem o caminho /v1/systemone.
TYPESAFE_BASE_URL=https://api.typesafe.ai

# jev-latest é um alias e pode passar a apontar para outro id.
# O default do código é o id versionado publicado na página Models.
JEV_MODEL=jev-1.14.0

# Tarifa de lista em USD por milhão de tokens, só para estimar custo a partir de usage.
# Fonte: https://docs.typesafe.ai/models (Jev 1.14). Saída documentada como gratuita.
# Não é medição deste estudo.
JEV_INPUT_USD_PER_MTOK=0.042
JEV_OUTPUT_USD_PER_MTOK=0

# Baseline de LLM com saída estruturada. O pacote openai só é importado na chamada ao vivo.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=
